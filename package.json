{
  "name": "rental-saas-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-tenant Rental Property Management SaaS for the UAE market",
  "scripts": {
    "predev": "pnpm --filter @rental-saas/contracts build",
    "prebuild": "pnpm --filter @rental-saas/contracts build",
    "pretest": "pnpm --filter @rental-saas/contracts build",
    "dev": "pnpm --parallel run dev",
    "build": "pnpm --recursive run build",
    "test": "pnpm --recursive run test",
    "lint": "pnpm --recursive run lint"
  },
  "packageManager": "pnpm@9.0.0",
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
